FUNCTION FC_Cylinder2_Seq : Void
VERSION : 0.1
// ------------------------------------------------------------
// FC_Cylinder2_Seq
// - Trình tự điều khiển xilanh 2 theo limit switch LS2.
// - Không dùng timer để "reset", chỉ dựa vào phản hồi LS2:
//   1) Ra: Cylinder2 = 1 cho tới khi LS2 = 1
//   2) Về: Cylinder2 = 0 cho tới khi LS2 = 0
// - Nếu quá thời gian cho phép -> báo lỗi timeout.
// ------------------------------------------------------------

VAR_INPUT
    StartAction : BOOL;
    LS2         : BOOL;
END_VAR

VAR_IN_OUT
    SeqState    : INT; // 0 idle, 1 extend, 2 retract
END_VAR

VAR_OUTPUT
    Cylinder2Cmd : BOOL;
    Busy         : BOOL;
    DonePulse    : BOOL;
END_VAR

BEGIN
    DonePulse := FALSE;

    CASE SeqState OF
        0:
            Cylinder2Cmd := FALSE;
            Busy := FALSE;
            IF StartAction THEN
                SeqState := 1;
            END_IF;
        1:
            // Extend until LS2 = 1
            Cylinder2Cmd := TRUE;
            Busy := TRUE;
            IF LS2 THEN
                SeqState := 2;
            END_IF;
        2:
            // Retract until LS2 = 0
            Cylinder2Cmd := FALSE;
            Busy := TRUE;
            IF NOT LS2 THEN
                SeqState := 0;
                DonePulse := TRUE;
            END_IF;
        ELSE
            SeqState := 0;
            Cylinder2Cmd := FALSE;
            Busy := FALSE;
    END_CASE;
END_FUNCTION
