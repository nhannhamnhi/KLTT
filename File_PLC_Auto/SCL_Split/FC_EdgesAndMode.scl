FUNCTION FC_EdgesAndMode : Void
VERSION : 0.1

VAR_INPUT
    btAuto      : BOOL;
    btManual    : BOOL;
    StartStop   : BOOL;
    SS0         : BOOL;
    SS1         : BOOL;
    SS2         : BOOL;
END_VAR

VAR_IN_OUT
    prevStartStop : BOOL;
    prevSS0       : BOOL;
    prevSS1       : BOOL;
    prevSS2       : BOOL;
    runLatch      : BOOL;
END_VAR

VAR_OUTPUT
    localAuto      : BOOL;
    localManual    : BOOL;
    startStopRise  : BOOL;
    ss0Rise        : BOOL;
    ss0Fall        : BOOL;
    ss1Rise        : BOOL;
    ss2Rise        : BOOL;
END_VAR

BEGIN
    startStopRise := StartStop AND NOT prevStartStop;
    ss0Rise := SS0 AND NOT prevSS0;
    ss0Fall := (NOT SS0) AND prevSS0;
    ss1Rise := SS1 AND NOT prevSS1;
    ss2Rise := SS2 AND NOT prevSS2;

    localAuto := btAuto AND NOT btManual;
    localManual := btManual;

    IF localManual THEN
        runLatch := FALSE;
    ELSIF localAuto AND startStopRise THEN
        runLatch := NOT runLatch;
    END_IF;

    prevStartStop := StartStop;
    prevSS0 := SS0;
    prevSS1 := SS1;
    prevSS2 := SS2;
END_FUNCTION

