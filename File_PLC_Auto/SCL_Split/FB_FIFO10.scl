FUNCTION_BLOCK FB_FIFO10
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    Push      : BOOL;
    PushValue : INT;
    Pop       : BOOL;
END_VAR

VAR_OUTPUT
    HeadValue : INT;
    Count     : INT;
    Overflow  : BOOL;
    Underflow : BOOL;
END_VAR

VAR
    arr       : ARRAY[0..9] OF INT;
    head      : INT;
    tail      : INT;
    cnt       : INT;
END_VAR

BEGIN
    Overflow := FALSE;
    Underflow := FALSE;

    IF Push THEN
        IF cnt >= 10 THEN
            Overflow := TRUE;
        ELSE
            arr[tail] := PushValue;
            tail := tail + 1;
            IF tail > 9 THEN
                tail := 0;
            END_IF;
            cnt := cnt + 1;
        END_IF;
    END_IF;

    IF cnt > 0 THEN
        HeadValue := arr[head];
    ELSE
        HeadValue := 0;
    END_IF;

    IF Pop THEN
        IF cnt <= 0 THEN
            Underflow := TRUE;
        ELSE
            head := head + 1;
            IF head > 9 THEN
                head := 0;
            END_IF;
            cnt := cnt - 1;
            IF cnt > 0 THEN
                HeadValue := arr[head];
            ELSE
                HeadValue := 0;
            END_IF;
        END_IF;
    END_IF;

    Count := cnt;
END_FUNCTION_BLOCK

