FUNCTION FC_ClassifyRule : INT
VERSION : 0.1
// ------------------------------------------------------------
// FC_ClassifyRule
// - Hàm phân loại theo rule đã thống nhất (phía Python).
// - Mục tiêu: đưa ra mã kết quả 0..4 để đồng nhất với PLC.
//
// Quy ước mã:
// - 0=WAIT, 1=OK, 2=NG_L, 3=NG_H, 4=MISSING
// ------------------------------------------------------------

VAR_INPUT
    tong_so      : INT;
    so_o_khuon   : INT;
    full_count   : INT;
    partial_count: INT;
    empty_count  : INT;
END_VAR

BEGIN
    // 0 WAIT, 1 OK, 2 NG_L, 3 NG_H, 4 MISSING
    IF tong_so = 0 THEN
        FC_ClassifyRule := 0;
    ELSIF tong_so < so_o_khuon THEN
        FC_ClassifyRule := 4;
    ELSIF full_count = so_o_khuon THEN
        FC_ClassifyRule := 1;
    ELSIF (full_count >= 3) OR ((full_count < 3) AND (empty_count > partial_count)) THEN
        FC_ClassifyRule := 2;
    ELSE
        FC_ClassifyRule := 3;
    END_IF;
END_FUNCTION
