ORGANIZATION_BLOCK OB1
TITLE = 'Main cycle'
VERSION : 0.1

VAR
    // Gợi ý:
    // 1) Tạo FB_Auto từ file FB_Auto.scl
    // 2) TIA sẽ yêu cầu tạo Instance DB (ví dụ: DB_FB_Auto)
    // 3) Gọi FB trong OB1 theo mẫu bên dưới
END_VAR

BEGIN
    // Lưu ý:
    // - Tên tag có thể khác project của bạn, cần map lại cho đúng.
    // - "DB_GET" là DB PLC nhận từ Python (PC -> PLC)
    // - "DB_PUT" là DB PLC gửi lên Python (PLC -> PC)
    FB_Auto_DB(
        btAuto := "btAuto",
        btManual := "btManual",
        StartStop := "Start-Stop",
        SS0 := "SS0",
        SS1 := "SS1",
        SS2 := "SS2",
        LS1 := "LS_1",
        LS2 := "LS_2",

        PC_DataReady := "DB_GET".PC_DataReady,
        PC_KetQua := "DB_GET".PC_KetQua,

        // Reset lỗi thủ công: map từ HMI hoặc 1 M-bit tự tạo
        ResetFault := "M1.7_ResetFault",

        PT_AI_Timeout := T#2S,
        PT_SS_Stuck := T#6S,
        PT_LS_Timeout := T#2S,

        Conveyor => "Conveyor",
        Cylinder1 => "Cylinder1",
        Cylinder2 => "Cylinder2",

        PLC_Auto => "DB_PUT".PLC_Auto,
        PLC_Manual => "DB_PUT".PLC_Manual,
        PLC_Running => "DB_PUT".PLC_Running,
        PLC_TriggerReq => "DB_PUT".PLC_TriggerReq,

        // Các tag debug/lỗi là tùy chọn, có thể bỏ nếu chưa dùng HMI
        ErrorActive => "M10.0_ErrorActive",
        ErrorCode => "MW20_ErrorCode",
        Error_AI_Timeout => "M10.1_ErrAI",
        Error_SS_Stuck => "M10.2_ErrSS0Stuck",
        Error_LS1_Timeout => "M10.3_ErrLS1",
        Error_LS2_Timeout => "M10.4_ErrLS2",
        Error_QueueOverflow => "M10.5_ErrQOverflow",
        Error_QueueUnderflow => "M10.6_ErrQUnderflow",
        Error_InvalidResult => "M10.7_ErrInvalidResult",
        QueueCount => "MW30_QueueCount",
        QueueHead => "MW32_QueueHead",
        QueueTail => "MW34_QueueTail",
        DebugState => "MW36_DebugState"
    );
END_ORGANIZATION_BLOCK
