FUNCTION_BLOCK FB_FIFO10
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// ------------------------------------------------------------
// FB_FIFO10
// - FIFO 10 phần tử dùng để ghi nhớ kết quả AI theo thứ tự sản phẩm.
// - Push: thêm 1 kết quả mới (khi sản phẩm qua SS0 và PC trả kết quả).
// - Peek: xem phần tử đầu (để quyết định xử lý tại SS1/SS2).
// - Pop: bỏ phần tử đầu khi sản phẩm đã xử lý xong vòng đời.
//
// Nếu FIFO đầy -> Overflow. Nếu Pop khi rỗng -> Underflow.
// ------------------------------------------------------------

VAR_INPUT
    Push      : BOOL;
    PushValue : INT;
    Pop       : BOOL;
END_VAR

VAR_OUTPUT
    HeadValue : INT;
    Count     : INT;
    Overflow  : BOOL;
    Underflow : BOOL;
END_VAR

VAR
    arr       : ARRAY[0..9] OF INT;
    head      : INT;
    tail      : INT;
    cnt       : INT;
END_VAR

BEGIN
    Overflow := FALSE;
    Underflow := FALSE;

    IF Push THEN
        IF cnt >= 10 THEN
            Overflow := TRUE;
        ELSE
            arr[tail] := PushValue;
            tail := tail + 1;
            IF tail > 9 THEN
                tail := 0;
            END_IF;
            cnt := cnt + 1;
        END_IF;
    END_IF;

    IF cnt > 0 THEN
        HeadValue := arr[head];
    ELSE
        HeadValue := 0;
    END_IF;

    IF Pop THEN
        IF cnt <= 0 THEN
            Underflow := TRUE;
        ELSE
            head := head + 1;
            IF head > 9 THEN
                head := 0;
            END_IF;
            cnt := cnt - 1;
            IF cnt > 0 THEN
                HeadValue := arr[head];
            ELSE
                HeadValue := 0;
            END_IF;
        END_IF;
    END_IF;

    Count := cnt;
END_FUNCTION_BLOCK
